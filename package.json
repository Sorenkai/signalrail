{
  "name": "signal-network",
  "version": "0.0.1",
  "private": true,
  "description": "Multiplayer browser-based UK railway signalling game built on real, attributed data (Phase 0: data foundation).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch-osm": "tsx tools/fetch-osm.ts",
    "data:import-osm": "tsx tools/import-osm.ts",
    "data:import-cif": "tsx tools/import-cif.ts",
    "data:validate": "tsx tools/validate.ts",
    "data:preview": "tsx tools/render-preview.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run data:validate",
    "data:import-corpus": "tsx tools/import-corpus.ts",
    "data:smart-coverage": "tsx tools/smart-coverage.ts",
    "data:reconcile-signals": "tsx tools/reconcile-signals.ts",
    "data:assess-geography": "tsx tools/assess-geography.ts",
    "data:control-membership": "tsx tools/control-membership.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
